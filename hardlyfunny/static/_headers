# Cloudflare static assets response headers: https://developers.cloudflare.com/workers/static-assets/headers/
# (Cloudflare already compresses responses; cloudflare.config.ts makes it serve 404.html for missing pages.)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Matches what WordPress.com sent, so the domain move doesn't weaken HTTPS. No includeSubDomains or preload.
  Strict-Transport-Security: max-age=31536000

# Our pages link these with ?v=<content hash>, so they can be cached forever.
/site.css
  Cache-Control: public, max-age=31536000, immutable
/site.js
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Comic art and cards aren't fingerprinted; a week keeps fixes from going stale for long.
/images/*
  Cache-Control: public, max-age=604800

# The feed is built as feed/index.html so /feed/ serves it; this keeps it from going out as HTML.
/feed/
  Content-Type: application/atom+xml; charset=utf-8
